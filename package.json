    "devDependencies": {
        "@types/graceful-fs": "^4.1.5",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.0",
        "jest": "^29.7.0",
        "tedb": "^0.4.4",
        "ts-jest": "^29.2.2",
        "typescript": "^5.5.4",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1"
    },
    "dependencies": {
